{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/wbs-json/0.1.0/wbs-json.schema.json",
  "title": "WBS-JSON Document",
  "description": "A vendor-neutral JSON format for representing a Work Breakdown Structure as flat nodes plus semantic relations.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "rootId",
    "nodes"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Version of the WBS-JSON schema used by this document."
    },
    "id": {
      "$ref": "#/$defs/WbsId"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "rootId": {
      "$ref": "#/$defs/NodeId",
      "description": "ID of the single root WBS node."
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/WbsNode"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Relation"
      },
      "default": []
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Resource"
      },
      "default": []
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Artifact"
      },
      "default": []
    },
    "metadata": {
      "$ref": "#/$defs/Metadata",
      "default": {}
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true,
      "default": {}
    }
  },
  "$defs": {
    "WbsId": {
      "type": "string",
      "minLength": 1
    },
    "NodeId": {
      "type": "string",
      "minLength": 1
    },
    "ResourceId": {
      "type": "string",
      "minLength": 1
    },
    "ArtifactId": {
      "type": "string",
      "minLength": 1
    },
    "RelationId": {
      "type": "string",
      "minLength": 1
    },
    "WbsCode": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9]+(\\.[A-Za-z0-9]+)*$"
    },
    "NodeType": {
      "type": "string",
      "enum": [
        "summary",
        "deliverable",
        "workPackage",
        "activity",
        "milestone"
      ]
    },
    "NodeStatus": {
      "type": "string",
      "enum": [
        "draft",
        "planned",
        "ready",
        "inProgress",
        "blocked",
        "completed",
        "cancelled"
      ]
    },
    "Effort": {
      "type": "object",
      "required": [
        "value",
        "unit"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "enum": [
            "hour",
            "personHour",
            "day",
            "personDay",
            "week",
            "personWeek",
            "month",
            "personMonth",
            "point"
          ]
        }
      }
    },
    "WbsNode": {
      "type": "object",
      "required": [
        "id",
        "parentId",
        "code",
        "name",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/NodeId"
        },
        "parentId": {
          "oneOf": [
            {
              "$ref": "#/$defs/NodeId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Parent node ID. null is allowed only for the root node by semantic validation."
        },
        "code": {
          "$ref": "#/$defs/WbsCode"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "$ref": "#/$defs/NodeType"
        },
        "description": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/NodeStatus",
          "default": "planned"
        },
        "owner": {
          "$ref": "#/$defs/ResourceId",
          "description": "Resource ID responsible for this node."
        },
        "assignees": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResourceId"
          },
          "uniqueItems": true,
          "default": [],
          "description": "Resource IDs assigned to work on this node."
        },
        "estimate": {
          "$ref": "#/$defs/Effort"
        },
        "actual": {
          "$ref": "#/$defs/Effort"
        },
        "startDate": {
          "type": "string",
          "format": "date"
        },
        "endDate": {
          "type": "string",
          "format": "date"
        },
        "progressPercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Optional completion percentage from 0 to 100."
        },
        "acceptanceCriteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArtifactId"
          },
          "uniqueItems": true,
          "default": []
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Tag"
          },
          "uniqueItems": true,
          "default": []
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "Tag": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^\\S+$"
    },
    "RelationType": {
      "type": "string",
      "enum": [
        "dependsOn",
        "blocks",
        "produces",
        "consumes",
        "implementsRequirement",
        "refinesBpmnTask",
        "linkedToIssue",
        "relatedTo"
      ]
    },
    "Relation": {
      "type": "object",
      "required": [
        "id",
        "type",
        "source",
        "target"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/RelationId"
        },
        "type": {
          "$ref": "#/$defs/RelationType"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "Resource": {
      "type": "object",
      "required": [
        "id",
        "name",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/ResourceId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "person",
            "team",
            "role",
            "organization"
          ]
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "Artifact": {
      "type": "object",
      "required": [
        "id",
        "name",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "document",
            "sourceCode",
            "design",
            "testCase",
            "configuration",
            "dataset",
            "service",
            "other"
          ]
        },
        "uri": {
          "type": "string",
          "format": "uri-reference"
        },
        "description": {
          "type": "string"
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "Metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdBy": {
          "type": "string"
        },
        "language": {
          "type": "string",
          "examples": [
            "ja-JP",
            "en-US"
          ]
        },
        "source": {
          "type": "string"
        }
      }
    }
  }
}
